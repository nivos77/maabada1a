

module treeBitMap (
    input  logic clk,
    input  logic resetN,
    input  logic [4:0] offsetX,
    input  logic [4:0] offsetY,
    input  logic InsideBody,
    
    output logic [7:0] RGBout,
    output logic drawingRequest
);

    logic [7:0] color;
    
    always_ff @(posedge clk or negedge resetN) begin
        if (!resetN) begin
            color <= 8'b00000000;
        end
        else if (InsideBody) begin

 
            if (offsetX >= 12 && offsetX <= 20 && offsetY >= 20)
                color <= 8'b101_010_00;
            else if (offsetY < 24)
                color <= 8'b000_111_00;
            else
                color <= 8'b000_000_00;
        end
    end

    assign RGBout = color;
    assign drawingRequest = InsideBody && (color != 8'b000_000_00);

endmodule